#!/bin/bash
# Claude Code hook - runs on Stop and Notification events
# Sends push notification via ntfy and stores target window for SSH forced command
#
# Usage: Configure in ~/.claude/settings.json under hooks.Stop and hooks.Notification

# Read JSON input from Claude Code
INPUT=$(cat)

# Extract fields from input
TRANSCRIPT_PATH=$(echo "$INPUT" | grep -o '"transcript_path":"[^"]*"' | cut -d'"' -f4)
HOOK_EVENT=$(echo "$INPUT" | grep -o '"hook_event_name":"[^"]*"' | cut -d'"' -f4)
NOTIFICATION_MSG=$(echo "$INPUT" | grep -o '"message":"[^"]*"' | cut -d'"' -f4)

# Get context - use tmux if running inside it, otherwise use Claude session slug
CWD=$(echo "$INPUT" | grep -o '"cwd":"[^"]*"' | cut -d'"' -f4)
PROJECT=$(basename "$CWD" 2>/dev/null || echo "unknown")

if [ -n "$TMUX" ]; then
    # Running inside tmux - use tmux context directly
    WIN=$(tmux display-message -p '#I')
    WIN_NAME=$(tmux display-message -p '#W')
    PROJECT=$(basename "$(tmux display-message -p '#{pane_current_path}')")
else
    # Not running inside tmux - check for custom title from /rename first
    CUSTOM_TITLE=$(grep '"type":"custom-title"' "$TRANSCRIPT_PATH" 2>/dev/null | tail -1 | grep -o '"customTitle":"[^"]*"' | cut -d'"' -f4)

    if [ -n "$CUSTOM_TITLE" ]; then
        # Use custom title from /rename
        WIN_NAME="$CUSTOM_TITLE"
    else
        # Check for auto-generated session summary
        SUMMARY=$(head -1 "$TRANSCRIPT_PATH" 2>/dev/null | grep '"type":"summary"' | grep -o '"summary":"[^"]*"' | cut -d'"' -f4)
        if [ -n "$SUMMARY" ]; then
            WIN_NAME=$(echo "$SUMMARY" | cut -c1-40)
            [ ${#SUMMARY} -gt 40 ] && WIN_NAME="${WIN_NAME}..."
        else
            # Fallback to first user message
            FIRST_MSG=$(grep '"type":"user"' "$TRANSCRIPT_PATH" 2>/dev/null | grep -v '"type":"tool_result"' | head -1 | sed 's/.*"content":"//' | sed 's/"},"uuid".*//' | head -c 50)
            WIN_NAME=$(echo "$FIRST_MSG" | tr '\n' ' ' | sed 's/\\n/ /g' | cut -c1-40)
            [ ${#FIRST_MSG} -gt 40 ] && WIN_NAME="${WIN_NAME}..."
            WIN_NAME="${WIN_NAME:-session}"
        fi
    fi
    WIN=""
fi

# Try to extract Claude's last response from transcript
TASK_SUMMARY=""
if [ -n "$TRANSCRIPT_PATH" ] && [ -f "$TRANSCRIPT_PATH" ]; then
    # Get the last assistant text response from the transcript
    LAST_RESPONSE=$(grep '"type":"assistant"' "$TRANSCRIPT_PATH" | grep '"type":"text"' | tail -1 | grep -o '"text":"[^"]*"' | head -1 | cut -d'"' -f4 | head -c 4500)

    if [ -n "$LAST_RESPONSE" ]; then
        # Convert escaped newlines to real newlines, then truncate (stay under 4KB)
        TASK_SUMMARY=$(printf '%b' "$LAST_RESPONSE" | head -c 4000)
    fi
fi

# Build notification based on event type
if [ "$HOOK_EVENT" = "Notification" ]; then
    # Waiting for input - use ❓ icon and the notification message
    ICON="❓"
    if [ -n "$NOTIFICATION_MSG" ]; then
        MESSAGE="${NOTIFICATION_MSG}"
    else
        MESSAGE="Waiting for input"
    fi
else
    # Stop event - task complete
    ICON="✅"
    if [ -n "$WIN" ]; then
        PREFIX="$WIN: "
    else
        PREFIX=""
    fi
    if [ -n "$TASK_SUMMARY" ]; then
        MESSAGE="${PREFIX}${TASK_SUMMARY}"
    else
        MESSAGE="${PREFIX}Task complete"
    fi
fi

# Build title - use project name if window name is generic
if [[ "$WIN_NAME" =~ ^\[.*\]$ ]] || [ -z "$WIN_NAME" ] || [ "$WIN_NAME" = "bash" ] || [ "$WIN_NAME" = "zsh" ]; then
    TITLE="$ICON $PROJECT"
else
    TITLE="$ICON [$WIN_NAME] $PROJECT"
fi

# Write target window for SSH forced command (claude-attach script)
echo "$WIN" > /tmp/claude-target

# Check if Mac is idle (skip notification if user is active)
IDLE_THRESHOLD=30  # 30 seconds
IDLE_TIME=$(ioreg -c IOHIDSystem | awk '/HIDIdleTime/ {print int($NF/1000000000); exit}')
if [ "$IDLE_TIME" -lt "$IDLE_THRESHOLD" ] 2>/dev/null; then
    # User is active at the Mac - skip phone notification
    exit 0
fi

# ntfy config
TOPIC="patrick-claude"
MAC_USER="patrickogrady"
MAC_HOST="100.122.215.101"

# Only add click action for tmux sessions
if [ -n "$WIN" ]; then
    CLICK_HEADER="-H \"Click: ssh://$MAC_USER@$MAC_HOST\""
else
    CLICK_HEADER=""
fi

curl -s \
    -H "Title: $TITLE" \
    -H "Priority: high" \
    $CLICK_HEADER \
    -d "$MESSAGE" \
    "ntfy.sh/$TOPIC" > /dev/null 2>&1 &

exit 0
